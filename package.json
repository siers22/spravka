{
  "name": "spravka-exam-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check-catalog.mjs && node --test tests/content/*.test.mjs && node scripts/check-content.mjs && node scripts/check-courses.mjs && node scripts/check-wpf.mjs && python3 scripts/check-example-archives.py && python3 scripts/check-web-archives.py",
    "check:pages": "node scripts/check-pages.mjs",
    "content:sync-examples": "node scripts/sync-2027-examples.mjs",
    "content:package-web": "python3 scripts/package-web-course.py",
    "check:web": "bash examples/ConferencePortal/bin/check-podman.sh"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "lucide-vue-next": "^0.468.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "@vitejs/plugin-vue": "^6.0.1"
  }
}
