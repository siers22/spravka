<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Учебная ИС</title>
<style>body{font:16px system-ui;margin:40px auto;padding:0 20px;max-width:850px;background:#f3f5f2;color:#163b30}input,select,button{font:inherit;padding:10px;margin:6px;border:1px solid #bccdc5;border-radius:5px}button{cursor:pointer;background:#163b30;color:white}a{color:#163b30}section{background:white;padding:20px;margin:16px 0;border-radius:10px}.message{background:#fff3cd;padding:15px}label{display:block}nav{display:flex;gap:20px}img{width:100%}.puzzle{display:grid;grid-template-columns:repeat(2,140px);gap:4px}.puzzle button{margin:0;padding:0;background:white;line-height:0}.puzzle button.selected{outline:4px solid orange}table{border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #ccc}</style></head>
<body><nav><a asp-page="/Index">Главная</a><a asp-page="/Login">Вход</a><a asp-page="/Admin/Index">Администратор</a><a href="/notes">API заметок</a></nav>@RenderBody()@await RenderSectionAsync("Scripts",required:false)</body></html>
