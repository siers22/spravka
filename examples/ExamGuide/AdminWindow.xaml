<Window x:Class="ExamGuide.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Информационные системы · Пользователи" Width="1000" Height="650" MinWidth="800" MinHeight="500">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock Text="Для изменения выберите строку. Для нового пользователя нажмите «Новая запись». Пустой новый пароль при изменении сохраняет прежний." TextWrapping="Wrap"/>
   <WrapPanel><TextBox x:Name="Login" Width="220" AutomationProperties.Name="Логин"/><PasswordBox x:Name="Password" Width="220" AutomationProperties.Name="Новый пароль"/><ComboBox x:Name="Role" SelectedIndex="0"><ComboBoxItem Content="Пользователь"/><ComboBoxItem Content="Администратор"/></ComboBox></WrapPanel>
   <CheckBox x:Name="Unblock" Content="Снять блокировку и обнулить ошибки" Margin="4"/>
   <WrapPanel><Button Content="Новая запись" Click="New_Click"/><Button x:Name="Save" Content="Сохранить" Click="Save_Click"/><Button Content="Обновить список" Click="Refresh_Click"/><Button Content="Назад" Click="Back_Click"/></WrapPanel>
  </StackPanel>
  <DataGrid x:Name="UsersGrid" SelectionChanged="SelectionChanged"><DataGrid.Columns>
   <DataGridTextColumn Header="ID" Binding="{Binding Id}"/><DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/><DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*"/><DataGridTextColumn Header="Ошибки" Binding="{Binding FailedAttempts}"/><DataGridCheckBoxColumn Header="Блокировка" Binding="{Binding IsBlocked}"/>
  </DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
