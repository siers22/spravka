<Window x:Class="ShoeStore.CartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь · Корзина" Icon="Assets/favicon.ico" Width="1000" Height="650" MinWidth="800" MinHeight="550">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Total" FontSize="24" Margin="4,12"/>
   <WrapPanel><TextBox x:Name="Quantity" Text="1" Width="90" AutomationProperties.Name="Новое количество"/><Button Content="Изменить количество выбранной строки (0 = удалить)" Click="Quantity_Click"/></WrapPanel>
   <TextBlock x:Name="CustomerLabel" Text="Клиент заказа (для менеджера и администратора)"/><ComboBox x:Name="Customer" DisplayMemberPath="FullName"/>
   <TextBlock Text="Цена и остаток повторно проверяются при подтверждении. До подтверждения заказ существует только в памяти окна." TextWrapping="Wrap" Margin="4,12"/>
   <WrapPanel><Button x:Name="Confirm" Content="Подтвердить заказ" Click="Confirm_Click"/><Button Content="Отменить корзину" Click="Cancel_Click"/><Button Content="Продолжить выбор" Click="Back_Click"/></WrapPanel>
  </StackPanel>
  <DataGrid x:Name="Rows" SelectionChanged="SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}"/><DataGridTextColumn Header="Пар" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=N2}"/><DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
