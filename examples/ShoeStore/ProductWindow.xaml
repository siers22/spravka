<Window x:Class="ShoeStore.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь · Модель" Icon="Assets/favicon.ico" Width="760" Height="680" MinWidth="650" MinHeight="580">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Image x:Name="Photo" Height="170" Stretch="Uniform"/><TextBlock x:Name="NameLabel" FontSize="24" TextWrapping="Wrap" Margin="0,12"/><TextBlock x:Name="Details" TextWrapping="Wrap"/><TextBlock x:Name="Sizes" Margin="0,12" TextWrapping="Wrap"/>
  <TextBlock Text="Доступный размер"/><ComboBox x:Name="Stock" DisplayMemberPath="Label"/><TextBlock Text="Количество пар"/><TextBox x:Name="Quantity" Text="1" AutomationProperties.Name="Количество пар"/>
  <Button x:Name="Add" Content="Добавить в корзину" Click="Add_Click"/><Button Content="Назад к каталогу" Click="Back_Click"/>
 </StackPanel></ScrollViewer>
</Window>
