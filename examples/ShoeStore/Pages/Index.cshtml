@page
@model IndexModel
@{ ViewData["Title"]="Каталог обуви"; }
<h1>Каталог «Чудо Обувь»</h1>
@if(User.Identity?.IsAuthenticated==true){
<form class="toolbar" id="filters"><input name="Query" value="@Model.Query" placeholder="Название или описание" aria-label="Поиск">
<select name="Category" aria-label="Категория"><option value="">Все категории</option>@foreach(var category in Model.Categories){<option value="@category" selected="@(category==Model.Category)">@category</option>}</select>
<select name="Sort" aria-label="Цена"><option value="asc" selected="@(Model.Sort!="desc")">Цена по возрастанию</option><option value="desc" selected="@(Model.Sort=="desc")">Цена по убыванию</option></select></form>
}else{<p class="muted">Для поиска, фильтров и оформления заказа войдите по логину.</p>}
<div id="products"><partial name="_Products" model="Model.Products" /></div>
@section Scripts{
<script>
const form=document.querySelector('#filters');
if(form){
let timer,controller;
const refresh=()=>{
clearTimeout(timer);
controller?.abort();
timer=setTimeout(async()=>{
controller=new AbortController();
const params=new URLSearchParams(new FormData(form));
try{
const response=await fetch('/?handler=List&'+params,{signal:controller.signal});
if(!response.ok)throw new Error('Ошибка чтения каталога');
document.querySelector('#products').innerHTML=await response.text();
}catch(error){if(error.name!=='AbortError')document.querySelector('#products').textContent='⚠ Ошибка. Проверьте БД и измените фильтр для повторной попытки.';}
},150);
};
form.addEventListener('input',refresh);
form.addEventListener('change',refresh);
form.addEventListener('submit',event=>event.preventDefault());
}
</script>
}
