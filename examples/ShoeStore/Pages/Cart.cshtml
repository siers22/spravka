@page
@model CartModel
@{ ViewData["Title"]="Корзина"; }
<h1>Подтвердить заказ</h1>
@if(Model.Error!=""){<div class="message error" role="alert"><b>⚠ Ошибка</b><p>@Model.Error</p></div>}
@if(Model.Rows.Count==0){<p>Корзина пуста. Выберите модель и размер в каталоге.</p>}
@foreach(var row in Model.Rows){<section class="product"><div><h2>@row.Product.Manufacturer | @row.Product.Name</h2><p>Размер @row.Stock.Size; доступно @row.Stock.Available</p><p>@row.Product.FinalPrice.ToString("N2") ₽ × @row.Line.Quantity = @((row.Product.FinalPrice*row.Line.Quantity).ToString("N2")) ₽</p><form method="post" asp-page-handler="Quantity"><input type="hidden" name="stockItemId" value="@row.Stock.Id"><input name="quantity" type="number" value="@row.Line.Quantity" min="0" max="@row.Stock.Available" step="1"><button>Изменить количество</button><small>0 — удалить позицию</small></form></div></section>}
<p>Итого: @Model.Rows.Sum(row=>row.Product.FinalPrice*row.Line.Quantity).ToString("N2") ₽</p>
<form method="post" asp-page-handler="Confirm">@if(Model.Staff){<label>Клиент<select name="customerId">@foreach(var user in Model.Users){<option value="@user.Id">@user.FullName</option>}</select></label>}<button disabled="@(Model.Rows.Count==0)">Подтвердить заказ</button></form>
<form method="post" asp-page-handler="Cancel"><button>Отказаться от заказа</button></form><a class="back" href="/">Назад: добавить ещё товары</a>
