<Window x:Class="ShoeStore.OrdersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь · Заказы" Icon="/ShoeStore;component/Assets/favicon.ico" Width="1100" Height="750" MinWidth="900" MinHeight="650">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DataGrid x:Name="Headers" SelectionChanged="OrderSelected"><DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding Id}"/><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="ФИО клиента" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}"/></DataGrid.Columns></DataGrid>
  <DataGrid x:Name="Lines" Grid.Row="1" Margin="0,16"><DataGrid.Columns><DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}"/><DataGridTextColumn Header="Пар" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Цена сделки" Binding="{Binding UnitPrice, StringFormat=N2}"/><DataGridTextColumn Header="Сумма строки" Binding="{Binding Total, StringFormat=N2}"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2"><TextBlock x:Name="Total"/><WrapPanel x:Name="AdminControls"><DatePicker x:Name="Date" Width="160"/><Button Content="Изменить дату" Click="Date_Click"/><Button Content="Удалить выбранную строку" Click="Line_Click"/></WrapPanel>
   <WrapPanel><Button Content="Удалить заказ целиком" Click="Remove_Click"/><Button Content="Добавить заказ через каталог" Click="Back_Click"/><Button Content="Обновить" Click="Refresh_Click"/><Button Content="Назад" Click="Back_Click"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
