<Application x:Class="ShoeStore.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Calibri"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="White"/><Setter Property="WindowStartupLocation" Value="CenterScreen"/></Style>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#70B2AF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="160"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
 </Application.Resources>
</Application>
