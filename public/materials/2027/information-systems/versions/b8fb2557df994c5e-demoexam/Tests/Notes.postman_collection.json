{
  "info": {
    "name": "ДЭ 09.02.07-5-2027 — API заметок",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Перед запуском запустите Start-Api.cmd и Tests/Start-Error-Api.ps1. Порт 5051 используется отдельным экземпляром API с недоступным портом БД для настоящей проверки статуса 500."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5050"
    },
    {
      "key": "errorBaseUrl",
      "value": "http://127.0.0.1:5051"
    }
  ],
  "item": [
    {
      "name": "01 Все заметки — 200 и JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Структура заметок\", function () {",
              "  pm.response.to.have.jsonSchema({ type: \"array\", items: {",
              "    type: \"object\", additionalProperties: false,",
              "    required: [\"id\", \"title_user\", \"content\", \"formatted_date\"],",
              "    properties: {",
              "      id: { type: \"integer\" }, title_user: { type: \"string\", pattern: \" - \" },",
              "      content: { type: \"string\" }, formatted_date: { type: \"string\", pattern: \"^[0-9]{2}\\\\.[0-9]{2}\\\\.[0-9]{4}$\" }",
              "    }",
              "  }});",
              "});",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Фильтр пользователя",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes?user_id=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Структура заметок\", function () {",
              "  pm.response.to.have.jsonSchema({ type: \"array\", items: {",
              "    type: \"object\", additionalProperties: false,",
              "    required: [\"id\", \"title_user\", \"content\", \"formatted_date\"],",
              "    properties: {",
              "      id: { type: \"integer\" }, title_user: { type: \"string\", pattern: \" - \" },",
              "      content: { type: \"string\" }, formatted_date: { type: \"string\", pattern: \"^[0-9]{2}\\\\.[0-9]{2}\\\\.[0-9]{4}$\" }",
              "    }",
              "  }});",
              "});",
              "pm.test(\"Только user25\", function () {",
              "  pm.response.json().forEach(n => pm.expect(n.title_user).to.match(/ - user25$/));",
              "});",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Нет данных — пустой массив",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes?user_id=2147483647"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Пустой массив\", function () { pm.expect(pm.response.json()).to.eql([]); });",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Неверный тип параметра — 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes?user_id=abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Сообщение об ошибке\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\"); });",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Неизвестный параметр — 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/notes?unknown=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Сбой подключения к БД — 500",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{errorBaseUrl}}/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 500\", function () { pm.response.to.have.status(500); });",
              "pm.test(\"Сообщение об ошибке\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\"); });",
              "pm.test(\"Валидный JSON\", function () { pm.response.json(); });",
              "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    }
  ]
}