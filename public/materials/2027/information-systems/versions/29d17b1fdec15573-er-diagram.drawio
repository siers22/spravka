<mxfile host="app.diagrams.net" type="device"><diagram name="Полная ER-схема" id="exam-er"><mxGraphModel dx="1400" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1654" pageHeight="2339"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="customers" value="&lt;b&gt;customers&lt;/b&gt;&lt;hr&gt;id varchar(9) PRIMARY KEY&lt;br&gt;name varchar(200) NOT NULL&lt;br&gt;inn varchar(20) NOT NULL&lt;br&gt;address varchar(300) NOT NULL&lt;br&gt;phone varchar(30) NOT NULL&lt;br&gt;customer_type varchar(30) NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="40" width="455" height="195" /></mxCell><mxCell id="products" value="&lt;b&gt;products&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;code varchar(30) UNIQUE NOT NULL&lt;br&gt;name varchar(200) NOT NULL&lt;br&gt;unit varchar(20) NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="40" width="455" height="170" /></mxCell><mxCell id="materials" value="&lt;b&gt;materials&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;code varchar(30) UNIQUE NOT NULL&lt;br&gt;name varchar(200) NOT NULL&lt;br&gt;unit varchar(20) NOT NULL&lt;br&gt;price decimal(18,4) NOT NULL CHECK (price &amp;gt;= 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="40" width="455" height="170" /></mxCell><mxCell id="operations" value="&lt;b&gt;operations&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;code varchar(30) UNIQUE NOT NULL&lt;br&gt;name varchar(200) NOT NULL&lt;br&gt;unit varchar(20) NOT NULL&lt;br&gt;price decimal(18,4) NOT NULL CHECK (price &amp;gt;= 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="455" height="170" /></mxCell><mxCell id="specification_materials" value="&lt;b&gt;specification_materials&lt;/b&gt;&lt;hr&gt;product_id int NOT NULL REFERENCES products(id)&lt;br&gt;material_id int NOT NULL REFERENCES materials(id)&lt;br&gt;consumption decimal(18,6) NOT NULL CHECK (consumption &amp;gt; 0)&lt;br&gt;PRIMARY KEY(product_id, material_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="430" width="455" height="170" /></mxCell><mxCell id="specification_operations" value="&lt;b&gt;specification_operations&lt;/b&gt;&lt;hr&gt;product_id int NOT NULL REFERENCES products(id)&lt;br&gt;operation_id int NOT NULL REFERENCES operations(id)&lt;br&gt;time_norm decimal(18,6) NOT NULL CHECK (time_norm &amp;gt; 0)&lt;br&gt;quantity decimal(18,6) NOT NULL CHECK (quantity &amp;gt; 0)&lt;br&gt;PRIMARY KEY(product_id, operation_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="430" width="455" height="170" /></mxCell><mxCell id="customer_orders" value="&lt;b&gt;customer_orders&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;order_number varchar(30) NOT NULL&lt;br&gt;order_date date NOT NULL&lt;br&gt;customer_id varchar(9) NOT NULL REFERENCES customers(id)&lt;br&gt;executor varchar(200) NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="820" width="455" height="170" /></mxCell><mxCell id="customer_order_items" value="&lt;b&gt;customer_order_items&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;order_id int NOT NULL REFERENCES customer_orders(id)&lt;br&gt;product_id int NOT NULL REFERENCES products(id)&lt;br&gt;quantity decimal(18,6) NOT NULL CHECK (quantity &amp;gt; 0)&lt;br&gt;sale_price decimal(18,4) NOT NULL CHECK (sale_price &amp;gt;= 0)&lt;br&gt;discount_amount decimal(18,4) NOT NULL CHECK (discount_amount &amp;gt;= 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="820" width="455" height="195" /></mxCell><mxCell id="production_orders" value="&lt;b&gt;production_orders&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;order_number varchar(30) NOT NULL&lt;br&gt;order_date date NOT NULL&lt;br&gt;launch_date date NOT NULL&lt;br&gt;department varchar(100) NOT NULL&lt;br&gt;executor varchar(200) NOT NULL&lt;br&gt;customer_order_id int NULL REFERENCES customer_orders(id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="820" width="455" height="220" /></mxCell><mxCell id="production_order_items" value="&lt;b&gt;production_order_items&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;production_order_id int NOT NULL REFERENCES production_orders(id)&lt;br&gt;product_id int NOT NULL REFERENCES products(id)&lt;br&gt;quantity decimal(18,6) NOT NULL CHECK (quantity &amp;gt; 0)&lt;br&gt;source_product_code varchar(30) NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1210" width="455" height="170" /></mxCell><mxCell id="production_materials" value="&lt;b&gt;production_materials&lt;/b&gt;&lt;hr&gt;production_order_id int NOT NULL REFERENCES production_orders(id)&lt;br&gt;material_id int NOT NULL REFERENCES materials(id)&lt;br&gt;quantity decimal(18,6) NOT NULL CHECK (quantity &amp;gt; 0)&lt;br&gt;source_unit varchar(20) NOT NULL, PRIMARY KEY(production_order_id, material_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="1210" width="455" height="170" /></mxCell><mxCell id="production_operations" value="&lt;b&gt;production_operations&lt;/b&gt;&lt;hr&gt;production_order_id int NOT NULL REFERENCES production_orders(id)&lt;br&gt;operation_id int NOT NULL REFERENCES operations(id)&lt;br&gt;quantity decimal(18,6) NOT NULL CHECK (quantity &amp;gt; 0)&lt;br&gt;source_unit varchar(20) NOT NULL, PRIMARY KEY(production_order_id, operation_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="1210" width="455" height="170" /></mxCell><mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;login varchar(100) NOT NULL UNIQUE&lt;br&gt;password_hash varchar(500) NOT NULL&lt;br&gt;role varchar(30) NOT NULL CHECK (role IN (&amp;#x27;Администратор&amp;#x27;,&amp;#x27;Пользователь&amp;#x27;))&lt;br&gt;failed_attempts int NOT NULL DEFAULT 0 CHECK (failed_attempts &amp;gt;= 0)&lt;br&gt;is_blocked int NOT NULL DEFAULT 0 CHECK (is_blocked IN (0,1))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1600" width="455" height="195" /></mxCell><mxCell id="notes" value="&lt;b&gt;notes&lt;/b&gt;&lt;hr&gt;id int PRIMARY KEY&lt;br&gt;title varchar(200) NOT NULL&lt;br&gt;content varchar(2000) NOT NULL&lt;br&gt;id_user int NOT NULL REFERENCES users(id)&lt;br&gt;created_at date NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3e4;strokeColor=#adc596;fontColor=#294633;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="555" y="1600" width="455" height="170" /></mxCell><mxCell id="edge1" value="product_id · N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#718d5b;fontSize=10;fontColor=#547041;" edge="1" parent="1" source="specification_materials" target="products"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="material_id · N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#718d5b;fontSize=10;fontColor=#547041;" edge="1" parent="1" source="specification_materials" target="materials"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="product_id · N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#718d5b;fontSize=10;fontColor=#547041;" edge="1" parent="1" source="specification_operations" target="products"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="operation_id · N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#718d5b;fontSize=10;fontColor=#547041;" edge="1" parent="1" source="specification_operations" target="operations"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="customer_id · N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#718d5b;fontSize=10;fontColor=#547041;" edge="1" parent="1" source="customer_orders" target="customers"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="order_id · N:1" style="edgeStyle=orthogonalEdgeStyl